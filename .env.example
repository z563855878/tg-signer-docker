# 复制为 .env，然后按注释填写。source .env 后再执行 deploy/*.sh
# 所有变量都有安全默认值，唯一必填的是 TG_SIGNER_GUI_AUTHCODE。

# ---- 必填：WebUI 授权码 ----
# 不要用弱口令；WebUI 监听 0.0.0.0 时任何能访问该端口的人都要靠它挡住。
TG_SIGNER_GUI_AUTHCODE=change-me-to-a-long-random-string

# ---- 容器与路径 ----
TG_SIGNER_ROOT=/opt/tg-signer
TG_SIGNER_IMAGE=ghcr.io/amchii/tg-signer:0.9.2-webui
GUI_PORT=9090

# ---- 任务与账号 ----
# 这是你在 tg-signer 里建的签到任务名，不是固定的 daily_checkin_xxx。
TG_SIGNER_TASK=my_sign
TG_ACCOUNT=my_account

# ---- 代理（可选）----
# 留空则 tg-signer 直连；Telegram 在多数网络下需要代理。
# socks5h:// 表示域名交给代理解析，可避免本地 DNS 污染。
TG_PROXY=

# ---- WebUI 存储密钥（可选）----
# 留空会在 $TG_SIGNER_ROOT/data/.signer/.gui_storage_secret 生成并持久化。
# 一旦改变，浏览器需要重新输入授权码。
TG_SIGNER_GUI_STORAGE_SECRET=
